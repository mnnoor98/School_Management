# ===================================================================
# School Management System (DMSC-101 Academic Portal) - Environment Config
# Copy this file to .env before starting containers with docker compose
# ===================================================================

# Database Settings
POSTGRES_DB=school_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeThisToAStrongPassword123!

# JWT Authentication
# In production, use a 256-bit cryptographically secure string (at least 32 characters)
JWT_SECRET_KEY=ChangeThisSuperSecretKeyForSchoolManagementSystem2026!@#$%^&*()_+
JWT_ISSUER=SchoolManagementApi
JWT_AUDIENCE=SchoolManagementClient
JWT_EXPIRY_HOURS=8

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5000

# Feature Toggles
FEATURE_ENABLE_WEB_DEPLOYMENT=false
FEATURE_ENABLE_WEB_BACKUP=true
